#[derive(Debug)]
pub struct Parser<'a> {
    typer: Typer<'a>,

    ast: Vec<AstNode<'a>>,
}

#[derive(Debug)]
enum ParseError {
    IncorrectType,
    Unterminated(char),
}

impl<'a> Parser<'a> {
    pub fn parse(tokenizer: Tokenizer<'a>) -> Self {
        // info!("{tokenizer:?}");

        let mut iter = tokenizer.tokens();
        let mut ast: Vec<AstNode<'a>> = vec![];
        let mut typer = Typer::default();

        info!("{:?}", iter);

        let mut idx = 0;
        for token in &iter[idx..] {
            if idx >= iter.len() {
                break;
            }
            info!(?token);
            match token {
                Token::Let => {
                    let (var, i) = Variable::parse(&iter[idx..]).unwrap();
                    ast.push(AstNode::Variable(var));
                    idx += i;
                }
                Token::WhiteSpace => {}
                Token::Equal => {}
                Token::Semicolon => {}
                Token::LeftAngleBracket => {}
                Token::RightAngleBracket => {}
                Token::Colon => {}
                Token::Comma => {}
                Token::LeftBracket => {}
                Token::RightBracket => {}
                Token::Dot => {}
                Token::Exclamation => {}
                Token::Plus => {}
                Token::Minus => {}
                Token::Multiply => {}
                Token::Divide => {}
                Token::Function => {
                    let (func, i) = FunctionDecl::parse(&iter[idx..]).unwrap();
                    info!(?func);

                    idx += i;
                }
                Token::TypeID(type_id) => {
                    info!(?type_id);
                }
                Token::Return => {}
                Token::Pub => match (&iter[idx + 1], &iter[idx + 2]) {
                    (Token::WhiteSpace, Token::Struct) => {
                        let (name, mut struc, i) = StructDecl::parse(&iter[idx..]).unwrap();
                        info!(?struc);
                        let mut fields = struc
                            .fields
                            .iter_mut()
                            .map(|f| (*f.0, *f.1))
                            .collect::<Vec<_>>();
                        fields.sort();
                        typer.register(name, &fields);

                        idx += i;
                    }
                    (Token::WhiteSpace, Token::Enum) => {
                        let (name, mut enu, i) = EnumDecl::parse(&iter[idx..]).unwrap();
                        info!(?name, ?enu, ?i);
                        let mut fields = enu
                            .fields
                            .iter_mut()
                            .map(|f| (*f.0, f.1.id()))
                            .collect::<Vec<_>>();
                        fields.sort();

                        typer.register(name, &fields);

                        idx += i;
                    }
                    t => panic!("{t:?} {token:?}"),
                },
                Token::Struct => {
                    todo!();
                    // let (name, mut struc, i) = Parser::parse_struct_decl(&iter[idx..]);
                    // info!(?struc);
                    // let mut fields = struc
                    //     .fields
                    //     .iter_mut()
                    //     .map(|f| (*f.0, *f.1))
                    //     .collect::<Vec<_>>();
                    // fields.sort();
                    // self.typer.register(name, &fields);
                    //
                    // idx += i;
                }
                Token::Enum => {
                    todo!();
                    // let (name, mut enu, i) = Parser::parse_enum(self.data, &iter[idx..]);
                    // info!(?name, ?enu, ?i);
                    // let mut fields = enu
                    //     .fields
                    //     .iter_mut()
                    //     .map(|f| (*f.0, f.1.id()))
                    //     .collect::<Vec<_>>();
                    // fields.sort();
                    //
                    // self.typer.register(name, &fields);
                    //
                    // idx += i;
                }
                Token::Number(_) => {}

                // things like var += 1;
                Token::Str(_) => {
                    todo!();
                    // let (var, i) = Parser::parse_variable_assignment(&iter[idx..]);
                    // self.ast.push(AstNode::Variable(var));
                    // idx += i;
                }
                _ => panic!(),
            }
            idx += 1;
        }

        Self { ast, typer }
    }
}

