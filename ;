#[cfg(test)]
mod parseable {
    use tracing::info;

    use crate::{
        parser::{Parseable, ParseableCtx},
        tokenizer::{Span, Token},
        types::{Number, Primitive, PrimitiveID, TypeID},
    };

    fn setup_logger() {
        let _guard =
            tracing::subscriber::set_global_default(tracing_subscriber::FmtSubscriber::new());
    }

    #[test]
    fn parse_primitive_number() {
        setup_logger();

        let (prim, _) = Primitive::parse_ctx(
            Some(TypeID::Primitive(PrimitiveID::I8)),
            &[Token::Number("10")],
        )
        .unwrap();

        info!(?prim);
        assert_eq!(Primitive::Number(Number::I8(10)), prim);
    }

    #[test]
    fn parse_primitive_string() {
        setup_logger();

        let (prim, _) = Primitive::parse(&[Token::Str("foo")]).unwrap();

        info!(?prim);
        assert_eq!(Primitive::String("foo"), prim);
    }
}
